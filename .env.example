# Supabase pooler (encode @ in password as %40)
DATABASE_URL="postgresql://postgres.PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Optional legacy anon key (either publishable or anon works)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""

DEMO_MODE="false"
NEXT_PUBLIC_DEMO_MODE="false"
NEXT_PUBLIC_APP_NAME="Klasshi"

# --- Mainnet (production) ---
NEXT_PUBLIC_SOLANA_CLUSTER="mainnet-beta"
NEXT_PUBLIC_SOLANA_RPC_URL="https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY"
NEXT_PUBLIC_USDC_MINT="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v"
NEXT_PUBLIC_USDT_MINT="Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB"

